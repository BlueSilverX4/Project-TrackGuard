<group name="trackguard,physical_security,">

  <!-- Base Decoder Rule for TrackGuard App -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="app_name">^trackguard_telemetry$</field>
    <description>TrackGuard infrastructure telemetry log ingested.</description>
  </rule>

  <!-- High Severity Rule: Track Intrusion Event -->
  <rule id="100201" level="12">
    <if_sid>100200</if_sid>
    <field name="event_type">^TRACK_INTRUSION$</field>
    <description>TrackGuard Alert: Unauthorized physical intrusion detected on $(location).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>track_intrusion,p1_incident,</group>
  </rule>

  <!-- High Confidence CCTV Correlation Rule -->
  <rule id="100202" level="14">
    <if_sid>100201</if_sid>
    <field name="cctv_confidence">^0\.9[0-9]|^1\.0</field>
    <description>TrackGuard CRITICAL: Track intrusion on $(location) verified by CCTV AI (>90% confidence). Initiate immediate signals hold.</description>
    <group>track_intrusion,critical_containment,</group>
  </rule>

</group>
